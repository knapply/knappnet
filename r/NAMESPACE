# ---- S3 methods for classes defined in this package -----------------------

# The net_frame class and its subclasses (R/net-frame.R, R/print-net-frame.R,
# R/descriptive.R, R/plot-net-frame.R, R/convert.R)
S3method(print, net_frame)
S3method(print, temporal_net_frame)
S3method(print, spatial_net_frame)
S3method(print, spatiotemporal_net_frame)
S3method(summary, net_frame)
S3method(plot, net_frame)
S3method(as.matrix, net_frame)
S3method(print, summary.net_frame)

# QAP tests (R/qap.R)
S3method(print, qap_cor)
S3method(summary, qap_cor)
S3method(plot, qap_cor)
S3method(print, summary.qap_cor)
S3method(print, mrqap)
S3method(summary, mrqap)
S3method(plot, mrqap)
S3method(print, summary.mrqap)

# Conditional uniform graph tests (R/cug.R)
S3method(print, cug_test)
S3method(summary, cug_test)
S3method(plot, cug_test)
S3method(print, summary.cug_test)

# Multidimensional scaling (R/scaling.R)
S3method(print, classical_mds)
S3method(plot, classical_mds)

# Positions (R/positions.R)
S3method(print, blockmodel)
S3method(plot, blockmodel)

# Whole-network structure (R/structure.R)
S3method(print, core_periphery)
S3method(plot, core_periphery)
S3method(print, small_world)
S3method(plot, small_world)

# Subgroups (R/subgroups.R)
S3method(print, lambda_sets)
S3method(plot, lambda_sets)



# ---- Methods of as_net_frame() for other classes ---------------------------

S3method(as_net_frame, default)
S3method(as_net_frame, net_frame)
S3method(as_net_frame, data.frame)
S3method(as_net_frame, matrix)
S3method(as_net_frame, Matrix)
S3method(as_net_frame, igraph)
S3method(as_net_frame, network)
S3method(as_net_frame, sf)
S3method(as_net_frame, sfnetwork)


# ---- Methods for generics of suggested packages ---------------------------
# Registered when that package is loaded (delayed S3 registration, R >= 3.6).

S3method(igraph::as.igraph, net_frame)
S3method(network::as.network, net_frame)
S3method(tidygraph::as_tbl_graph, net_frame)
S3method(sf::st_as_sf, net_frame)
S3method(sfnetworks::as_sfnetwork, net_frame)
