# Windows build. R's toolchain (Rtools) uses the GNU ABI, so the engine is
# compiled for the matching *-pc-windows-gnu (or gnullvm) target.

ifeq ($(R_ARCH),/aarch64)
  RUST_TARGET = aarch64-pc-windows-gnullvm
else
  RUST_TARGET = x86_64-pc-windows-gnu
endif

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(RUST_TARGET)/release
STATLIB = $(LIBDIR)/libcapi.a

PKG_CPPFLAGS = -I.
# Link the static archive by path rather than -lcapi, which could resolve to
# the import library of the DLL that the build also emits.
PKG_LIBS = $(STATLIB) -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lsynchronization

all: $(SHLIB) cleanup

$(SHLIB): $(STATLIB)

# As CRAN's notes on Rust packages suggest, cargo is also looked for in
# ~/.cargo/bin (where rustup installs it), and a missing or outdated
# toolchain stops the build with instructions instead of a cryptic error.
export PATH := $(PATH):$(HOME)/.cargo/bin

$(STATLIB):
	@if ! command -v cargo >/dev/null 2>&1 || ! command -v rustc >/dev/null 2>&1; then \
	  echo "------------------------------------------------------------------"; \
	  echo "ERROR: this package is written partly in Rust, and building it"; \
	  echo "needs cargo and rustc (version 1.70 or later), which were not found."; \
	  echo "Install Rust from https://www.rust-lang.org/tools/install (rustup),"; \
	  echo "or with your system's package manager: 'cargo' on Debian, Ubuntu,"; \
	  echo "and Fedora, or 'rust' on Homebrew. Then install this package again."; \
	  echo "------------------------------------------------------------------"; \
	  exit 1; \
	fi
	@minor=$$(rustc --version | sed -n 's/^rustc 1\.\([0-9][0-9]*\)\..*/\1/p'); \
	if [ -n "$$minor" ] && [ "$$minor" -lt 70 ]; then \
	  echo "ERROR: rustc 1.70 or later is needed, but $$(rustc --version) was found."; \
	  echo "Update Rust with 'rustup update' or your system's package manager."; \
	  exit 1; \
	fi
	@echo "rustc version: $$(rustc --version)"
	@echo "cargo version: $$(cargo --version)"
	export CARGO_HOME="$(CURDIR)/rust/.cargo" && \
	  cargo build --release --offline --locked -j 2 -p capi --lib \
	    --target=$(RUST_TARGET) \
	    --manifest-path="$(CURDIR)/rust/Cargo.toml" --target-dir="$(TARGET_DIR)"

cleanup: $(SHLIB)
	rm -Rf "$(LIBDIR)/build" "$(LIBDIR)/deps" "$(LIBDIR)/incremental" \
	  "$(CURDIR)/rust/.cargo"

.PHONY: all cleanup
